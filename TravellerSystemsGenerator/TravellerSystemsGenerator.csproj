<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TravellerGenesisCLI</AssemblyName>
    <RootNamespace>TravellerSystemGenerator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TravellerGenesis.Core\TravellerGenesis.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\TravellerGenesis\TravellerGenesis.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>TravellerGenesis.ico</Link>
    </Content>
  </ItemGroup>

</Project>
